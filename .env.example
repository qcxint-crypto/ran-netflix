# Copy to .env.local for local development. Never commit real values.

# Public site identity, read at build time.
NEXT_PUBLIC_SITE_NAME=RANStream
NEXT_PUBLIC_SITE_URL=<YOUR_SITE_URL>

# Upstream scrape target (OtakuDesu-compatible domain).
SCRAPE_BASE_URL=https://otakudesu.cloud

# Set to "1" to enable the Animasu source in the episode scraper chain.
ENABLE_ANIMASU=

# FlareSolverr endpoint used to get past Cloudflare on scrape targets.
# Leave empty to skip the solver path.
FLARESOLVERR_URL=<YOUR_FLARESOLVERR_URL>

# MyAnimeList API v2 client ID (extracted from official MAL app for research; see _re/).
MAL_CLIENT_ID=<YOUR_MAL_CLIENT_ID>

# Gogoanime mirror base URL (rotates; recovered from Anime X Nonton apk analysis).
GOGO_BASE_URL=https://gogoanime.fi
